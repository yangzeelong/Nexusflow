@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The exported target links spdlog and yaml-cpp, so consumers must be able to
# resolve both targets. Neither one appears in a public header -- nexusflow's own
# headers include no third-party header, Logging.hpp included -- so these are link
# dependencies of the static library rather than part of the API.
if(NOT TARGET spdlog::spdlog)
    find_dependency(spdlog)
endif()
if(NOT TARGET yaml-cpp::yaml-cpp)
    find_dependency(yaml-cpp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/nexusflowTargets.cmake")

check_required_components(Nexusflow)
